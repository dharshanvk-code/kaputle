  "steps": [
    {"title":"Stand up the left side panel","text":"Stand side panel A upright with its pre-drilled holes facing right.","tool":"Hands","parts":["sideL"],"from":[0,25,0],"view":35},
    {"title":"Tap 4 dowels into the left side","text":"Push wooden dowels E into the four holes, then tap them with a hammer until half of each dowel sticks out.","tool":"Hammer","parts":["dowelL1","dowelL2","dowelL3","dowelL4"],"slide":4,"view":50},
    {"title":"Fit the top and bottom panels","text":"Line up the holes in the ends of both B panels with the dowels and push them on.","tool":"Hands","parts":["bottom","top"],"from":[16,0,0],"view":35},
    {"title":"Tap 4 dowels into the right ends","text":"Push dowels E into the holes in the right-hand ends of both B panels.","tool":"Hammer","parts":["dowelR1","dowelR2","dowelR3","dowelR4"],"slide":4,"view":50},
    {"title":"Fit the right side panel","text":"Press the second side panel A onto the dowels, holes facing in.","tool":"Hands","parts":["sideR"],"from":[18,0,0],"view":40},
    {"title":"Screw the four corners","text":"Drive two screws F through each side panel into the top and bottom. Snug, not overtightened.","tool":"Screwdriver","parts":["screwL1","screwL2","screwL3","screwL4","screwR1","screwR2","screwR3","screwR4"],"slide":5,"spin":6,"view":25},
    {"title":"Push in the shelf pins","text":"Press four shelf pins G into the holes at the height you want the shelf.","tool":"Hands","parts":["pinL1","pinL2","pinR1","pinR2"],"slide":2.5,"view":25},
    {"title":"Rest the shelf on the pins","text":"Slide shelf C in from the front until it sits flat on all four pins.","tool":"Hands","parts":["shelf"],"from":[0,0,34],"view":25},
    {"title":"Place the back panel","text":"Turn the bookshelf around. Lay back panel D on the back edges, smooth side facing in.","tool":"Hands","parts":["back"],"from":[0,0,-30],"view":205},
    {"title":"Nail on the back panel","text":"Tap six nails H through the back panel into the edges of the side panels.","tool":"Hammer","parts":["nail1","nail2","nail3","nail4","nail5","nail6"],"slide":3,"view":205}
  ]
