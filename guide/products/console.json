 "steps": [
  {
   "manual": 1,
   "title": "Screw the hanger bolts into the legs",
   "text": "With both leg panels lying flat on a soft surface, use the wrench (113453) to screw the wood-thread end of each hanger bolt into the leg. Leave the machine thread sticking out.",
   "tool": "Wrench",
   "parts": [
    "boltL1",
    "boltL2",
    "boltR1",
    "boltR2"
   ],
   "slide": 5,
   "spin": 4,
   "view": 30
  },
  {
   "manual": 2,
   "title": "Screw the cam studs into the tabletop",
   "text": "Screw the four cam studs into the holes near each end of the tabletop, with the tabletop lying flat.",
   "tool": "Screwdriver",
   "parts": [
    "studL1",
    "studL2",
    "studR1",
    "studR2"
   ],
   "slide": 4,
   "spin": 3,
   "view": 30
  },
  {
   "manual": 3,
   "title": "Push dowels into the shelf ends",
   "text": "Press two wooden dowels into the holes in each end of the shelf.",
   "tool": "Hands",
   "parts": [
    "sdowelL1",
    "sdowelL2",
    "sdowelR1",
    "sdowelR2"
   ],
   "slide": 3,
   "view": 30
  },
  {
   "manual": 3,
   "title": "Push the legs onto the shelf",
   "text": "Push a leg panel onto each end of the shelf, so the bolts and dowels go into the shelf. The large holes in the shelf face up.",
   "tool": "Hands",
   "parts": [
    "shelf",
    "legL",
    "legR"
   ],
   "approach": {
    "shelf": [
     0,
     18,
     0
    ],
    "legL": [
     -28,
     0,
     0
    ],
    "legR": [
     28,
     0,
     0
    ]
   },
   "view": 30
  },
  {
   "manual": 4,
   "title": "Thread a nut onto each bolt",
   "text": "Through the large holes, thread a hex nut onto each bolt, flange side toward the bolt end.",
   "tool": "Hands",
   "parts": [
    "nutL1",
    "nutL2",
    "nutR1",
    "nutR2"
   ],
   "slide": 2,
   "spin": 2,
   "view": 20
  },
  {
   "manual": 4,
   "title": "Fit the inserts and tighten",
   "text": "Press a plastic insert down over each nut, then tighten the nuts with the wrench until the shelf is firm.",
   "tool": "Wrench",
   "parts": [
    "clipL1",
    "clipL2",
    "clipR1",
    "clipR2"
   ],
   "from": [
    0,
    6,
    0
   ],
   "view": 20
  },
  {
   "manual": 5,
   "title": "Push dowels into the legs",
   "text": "Press two wooden dowels into the end of each leg that will meet the tabletop.",
   "tool": "Hands",
   "parts": [
    "tdowelL1",
    "tdowelL2",
    "tdowelR1",
    "tdowelR2"
   ],
   "slide": 3,
   "view": 30
  },
  {
   "manual": 5,
   "title": "Lower the legs onto the tabletop",
   "text": "Lift the legs and shelf together and lower them onto the tabletop, so the cam studs and dowels go into the legs.",
   "tool": "Hands",
   "parts": [
    "top"
   ],
   "lower": 32,
   "from": [
    0,
    10,
    0
   ],
   "view": 30
  },
  {
   "manual": 6,
   "title": "Turn the cam locks",
   "text": "Put a cam lock into each hole on the inside of the legs and turn it with a screwdriver until it grips the cam stud.",
   "tool": "Screwdriver",
   "parts": [
    "camL1",
    "camL2",
    "camR1",
    "camR2"
   ],
   "slide": 2,
   "spin": 1,
   "view": 55
  },
  {
   "manual": 7,
   "title": "Fit the caps and felt pads",
   "text": "Press the caps into the four large holes in the shelf. Stick a felt pad on each corner of the legs.",
   "tool": "Hands",
   "parts": [
    "capL1",
    "capL2",
    "padL1",
    "padL2",
    "capR1",
    "capR2",
    "padR1",
    "padR2"
   ],
   "slide": 4,
   "view": 20
  },
  {
   "type": "flip",
   "axis": "x",
   "title": "Turn the table upright",
   "text": "Turn the table over so it stands on its felt pads. Lift it, don\u2019t drag it.",
   "tool": "Hands",
   "parts": [],
   "view": 30,
   "lift": 40
  }
 ],
