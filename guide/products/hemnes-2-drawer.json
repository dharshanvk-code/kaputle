  "steps": [
    {"manual":1,"title":"Screw cam bolts into the legs","text":"Lay legs L1, L2, R1 and R2 on a soft surface and screw two cam bolts 118331 into each leg until the collar is flush.","tool":"Screwdriver","parts":["boltLeg-1","boltLeg-2","boltLeg-3","boltLeg-4","boltLeg-5","boltLeg-6","boltLeg-7","boltLeg-8"],"slide":2,"spin":4,"view":30},
    {"manual":2,"title":"Tap dowels into the legs","text":"Push two dowels 101350 into each leg beside the cam bolts.","tool":"Hands","parts":["dowelLeg-1","dowelLeg-2","dowelLeg-3","dowelLeg-4","dowelLeg-5","dowelLeg-6","dowelLeg-7","dowelLeg-8"],"slide":3,"view":30},
    {"manual":2,"title":"Join the legs to the side panels","text":"Press legs L1 and L2 onto the left side panel and legs R1 and R2 onto the right side panel, holes facing up.","tool":"Hands","parts":["sideR","legR1","legR2","legL1","legL2"],"local":true,"approach":{"legR1":[0,0,12],"legR2":[0,0,-12],"legL1":[0,0,12],"legL2":[0,0,-12]},"view":30},
    {"manual":3,"title":"Lock the side panels to the legs","text":"Put eight cam locks 110630 into the side panels and turn them clockwise to lock onto the cam bolts.","tool":"Screwdriver","parts":["camSide-1","camSide-2","camSide-3","camSide-4","camSide-5","camSide-6","camSide-7","camSide-8"],"slide":1.5,"spin":0.5,"view":30},
    {"manual":4,"title":"Press on the glides","text":"Push a floor glide into the bottom end of each leg.","tool":"Hands","parts":["glide-1","glide-2","glide-3","glide-4"],"slide":2,"view":40},
    {"manual":5,"title":"Screw on the cabinet runners","text":"Fasten two runners 112479 to the inside of each side panel with screws 100349.","tool":"Screwdriver","parts":["runCLU","runCLL","runCRU","runCRL","scrRunC-1","scrRunC-2","scrRunC-3","scrRunC-4","scrRunC-5","scrRunC-6","scrRunC-7","scrRunC-8"],"local":true,"approach":{"runCLU":[8,0,0],"runCLL":[8,0,0],"runCRU":[-8,0,0],"runCRL":[-8,0,0]},"slide":2,"spin":3,"view":30},
    {"manual":6,"title":"Screw in the rail cam bolts","text":"Screw eight cam bolts 118331 into the inner faces of the legs, three in each front leg and one in each back leg.","tool":"Screwdriver","parts":["boltRail-1","boltRail-2","boltRail-3","boltRail-4","boltRail-5","boltRail-6","boltRail-7","boltRail-8"],"slide":2,"spin":4,"view":30},
    {"manual":7,"title":"Tap dowels into the right legs","text":"Push four dowels 101350 into the right-hand legs next to the cam bolts.","tool":"Hands","parts":["dowelRailR-1","dowelRailR-2","dowelRailR-3","dowelRailR-4"],"slide":3,"view":30},
    {"manual":7,"title":"Stand the four rails on the right side","text":"Fit the three front rails and the back rail onto the dowels and cam bolts of the right side assembly.","tool":"Hands","parts":["railFT","railFM","railFB","railBB"],"local":true,"from":[-30,0,0],"view":30},
    {"manual":8,"title":"Lock the rails to the right side","text":"Insert four cam locks 110630 into the rails and turn them clockwise.","tool":"Screwdriver","parts":["camRailR-1","camRailR-2","camRailR-3","camRailR-4"],"slide":1.5,"spin":0.5,"view":30},
    {"manual":9,"title":"Tap dowels into the rail tops","text":"Push four dowels 101350 into the free ends of the rails.","tool":"Hands","parts":["dowelRailL-1","dowelRailL-2","dowelRailL-3","dowelRailL-4"],"slide":3,"view":30},
    {"manual":9,"title":"Lower the left side onto the rails","text":"Lower the left side assembly onto the rails so the dowels and cam bolts enter their holes.","tool":"Hands","parts":["sideL"],"local":true,"from":[-35,0,0],"view":30},
    {"manual":10,"title":"Lock the rails to the left side","text":"Insert four cam locks 110630 into the rails and turn them clockwise.","tool":"Screwdriver","parts":["camRailL-1","camRailL-2","camRailL-3","camRailL-4"],"slide":1.5,"spin":0.5,"view":30},
    {"manual":11,"title":"Screw cam bolts into the top","text":"Lay the top face down on a soft surface and screw four cam bolts 118331 into its underside.","tool":"Screwdriver","parts":["boltTop-1","boltTop-2","boltTop-3","boltTop-4"],"slide":2,"spin":4,"view":30},
    {"type":"flip","manual":12,"axis":"z","angle":90,"title":"Stand the frame upright","text":"Stand the frame up on its glides.","tool":"Hands","parts":[]},
    {"manual":12,"title":"Tap dowels into the side tops","text":"Push two dowels 101350 into the top edge of each side panel.","tool":"Hands","parts":["dowelTop-1","dowelTop-2","dowelTop-3","dowelTop-4"],"slide":3,"view":30},
    {"manual":12,"title":"Lower the top on","text":"Lower the top onto the frame so the dowels and cam bolts go into their holes.","tool":"Hands","parts":["top"],"local":true,"from":[0,20,0],"view":30},
    {"manual":13,"title":"Lock the top","text":"Insert four cam locks 110630 into the side panels just under the top and turn them clockwise.","tool":"Screwdriver","parts":["camTop-1","camTop-2","camTop-3","camTop-4"],"slide":1.5,"spin":0.5,"view":30},
    {"manual":14,"title":"Bolt the top rail to the top","text":"Screw two bolts 100214 up through the front top rail into the top with Allen key 100001.","tool":"Wrench","parts":["boltTR-1","boltTR-2"],"slide":5,"spin":6,"view":20},
    {"type":"flip","manual":15,"axis":"x","angle":90,"title":"Lay the chest on its front","text":"Carefully lay the chest down on its front on a soft surface.","tool":"Hands","parts":[]},
    {"manual":15,"title":"Slide in the back panel","text":"Slide the back panel into the groove in the top so it sits in the rebates of the back legs.","tool":"Hands","parts":["back"],"local":true,"from":[0,0,-25],"view":200},
    {"manual":15,"title":"Nail the first corner","text":"Line up the back panel edge and tap one nail 101221 through it into a back leg.","tool":"Hammer","parts":["nailA"],"slide":3,"view":200},
    {"manual":16,"title":"Nail the opposite corner","text":"Check the panel is square and tap one nail 101221 into the opposite corner.","tool":"Hammer","parts":["nailB"],"slide":3,"view":200},
    {"manual":17,"title":"Nail the rest of the back panel","text":"Tap in the remaining 14 nails 101221 along the back legs and the bottom rail.","tool":"Hammer","parts":["nailC-1","nailC-2","nailC-3","nailC-4","nailC-5","nailC-6","nailC-7","nailC-8","nailC-9","nailC-10","nailC-11","nailC-12","nailC-13","nailC-14"],"slide":3,"view":200},
    {"type":"flip","axis":"x","angle":-90,"title":"Stand the chest up","text":"Stand the chest upright on its glides.","tool":"Hands","parts":[]},
    {"manual":24,"title":"Tap dowels into the drawer sides","text":"For both drawers, push two dowels 101345 into the front end of each drawer side.","tool":"Hands","parts":["dowelDr-1","dowelDr-2","dowelDr-3","dowelDr-4","dowelDr-5","dowelDr-6","dowelDr-7","dowelDr-8"],"slide":3,"view":30},
    {"manual":25,"title":"Screw cam bolts into the drawer fronts","text":"Lay each drawer front face down and screw four cam bolts 123492 into its back.","tool":"Screwdriver","parts":["boltDr-1","boltDr-2","boltDr-3","boltDr-4","boltDr-5","boltDr-6","boltDr-7","boltDr-8"],"slide":2,"spin":4,"view":30},
    {"manual":26,"title":"Fit the drawer sides","text":"Press two sides onto each drawer front over the dowels and cam bolts.","tool":"Hands","parts":["dsUL","dsUR","dsLL","dsLR"],"local":true,"from":[0,0,-20],"view":30},
    {"manual":27,"title":"Lock the drawer sides","text":"Insert four cam locks 110630 into each drawer's sides and turn them clockwise.","tool":"Screwdriver","parts":["camDr-1","camDr-2","camDr-3","camDr-4","camDr-5","camDr-6","camDr-7","camDr-8"],"slide":1.5,"spin":0.5,"view":30},
    {"manual":28,"title":"Slide in the drawer bottoms","text":"Slide each drawer bottom down the grooves in the sides until it sits in the front's groove.","tool":"Hands","parts":["dbotU","dbotL"],"local":true,"from":[0,0,-30],"view":30},
    {"manual":29,"title":"Fit the drawer backs","text":"Lay a back panel between the open ends of each drawer's sides, on top of the bottom.","tool":"Hands","parts":["dbU","dbL"],"local":true,"from":[0,0,-20],"view":30},
    {"manual":30,"title":"Pin the backs in place","text":"Hammer four drive pins 110519 through the sides of each drawer into the back.","tool":"Hammer","parts":["nailDr-1","nailDr-2","nailDr-3","nailDr-4","nailDr-5","nailDr-6","nailDr-7","nailDr-8"],"slide":4,"view":30},
    {"type":"turn","manual":31,"turn":["dfU","dfL"],"pose":"upright","title":"Turn the drawers upright","text":"Stand both drawers on their bottoms.","tool":"Hands","parts":[]},
    {"manual":31,"title":"Fit the drawer runners","text":"Press a runner 112479 under the bottom edge of each drawer side and fix each with two screws 100365.","tool":"Screwdriver","parts":["runDUL","runDUR","runDLL","runDLR","scrRunD-1","scrRunD-2","scrRunD-3","scrRunD-4","scrRunD-5","scrRunD-6","scrRunD-7","scrRunD-8"],"local":true,"from":[0,8,0],"slide":2,"spin":3,"view":30},
    {"manual":32,"title":"Screw in the tray support strips","text":"Place a support strip against the inside of each drawer side, pushed up as far as it goes, and fix each with two screws 109053.","tool":"Screwdriver","parts":["stUL","stUR","stLL","stLR","scrStrip-1","scrStrip-2","scrStrip-3","scrStrip-4","scrStrip-5","scrStrip-6","scrStrip-7","scrStrip-8"],"local":true,"from":[0,12,0],"slide":3,"spin":5,"view":30},
    {"manual":33,"title":"Fit the knobs","text":"Hold a knob 117615 to the front of each drawer and screw it on from inside with screw 100413.","tool":"Screwdriver","parts":["knob-1","knob-2","scrKnob-1","scrKnob-2"],"slide":3,"spin":5,"view":20},
    {"manual":34,"title":"Start the tray","text":"Fit the two tray ends to the grooved tray panel with one screw 109053 at each end.","tool":"Screwdriver","parts":["trayEL","trayER","scrTray1-1","scrTray1-2"],"local":true,"from":[0,0,8],"slide":3,"spin":5,"view":30},
    {"manual":35,"title":"Slide in the tray bottom","text":"Slide the tray bottom down into the groove.","tool":"Hands","parts":["trayBot"],"local":true,"from":[0,0,12],"view":30},
    {"manual":36,"title":"Fit the second tray panel","text":"Lay the second tray panel on top, catching the edge of the bottom in its groove.","tool":"Hands","parts":["trayF"],"local":true,"from":[0,0,12],"view":30},
    {"manual":37,"title":"Screw the tray together","text":"Drive one screw 109053 through each tray end into the second panel.","tool":"Screwdriver","parts":["scrTray2-1","scrTray2-2"],"slide":3,"spin":5,"view":30},
    {"manual":38,"title":"Slide in the drawers","text":"Set each drawer's runners on the cabinet runners and push the drawers in.","tool":"Hands","parts":["dfU","dfL"],"local":true,"from":[0,0,35],"view":20},
    {"manual":39,"title":"Drop in the tray","text":"Open the upper drawer and set the tray on its support strips.","tool":"Hands","parts":["trayB"],"local":true,"from":[0,20,0],"view":20}
